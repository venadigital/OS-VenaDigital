{
  "manifest_version": 3,
  "name": "Vena OS",
  "version": "2.0.0",
  "description": "Herramientas de dibujo sobre la página que estás viendo. Las capturas quedan en Documentos de Vena OS.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Dibujar en esta página",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "scripting",
    "storage",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "https://os.venadigital.com.co/*",
      "http://localhost:5183/*"
    ]
  }
}
